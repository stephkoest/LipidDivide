		"""

rule merge_ingroup_outgroup_step3:
	input:
		ingroup="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.ingroup.txt",
		outgroup="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.outgroup.txt",
		NOG_fasta="results/{sample}." + cd_hit_identity + ".faa",
		add_fasta="results/{sample}." + cd_hit_identity + ".focalclade.homologs." + cd_hit_identity + ".rename.faa"
	output:
		"results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.faa"
	conda:
		"envs/Bio.yaml"
	shell:
		"""
		python bin/fastaGrep.py <(cat {input.ingroup} {input.outgroup}) <(cat {input.NOG_fasta} {input.add_fasta}) > {output}
		"""

rule mafft_step4:
