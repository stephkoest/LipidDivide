rule interproscan_step4:
	input:
		"results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.faa"
	output:
		"results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected_interpro.tsv"
	threads: 4
	log:
		"results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected_interpro.log"
	shell:
		"interproscan.sh -appl Pfam -cpu {threads} -f tsv -iprlookup --pathways -i {input} -o {output}"

rule plot_tree_step4:
	input: 
		tree="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.trim." + conserved_residues + ".fasttree.tre",
		names="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.filter.names.txt",
		interpro="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected_interpro.tsv",
		outgroup="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.outgroup.txt"
	output: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.trim." + conserved_residues + ".fasttree.pdf"
	conda: "envs/Bio.yaml"
	shell:
		"python bin/plotTree.py {input.tree} {output} {input.names} {input.interpro}"

rule run_Treemmer_step5:
	input: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.trim." + conserved_residues + ".fasttree.tre"
	output: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.trim." + conserved_residues + ".fasttree.tre" + "_trimmed_list_RTL_" + str(RTL)
	params: 
		RTL=config["RTL"],
		r=config["sample_r"]
	conda: "envs/Bio.yaml"
	shell:
		"""
		python bin/Treemmer_v0.3.py --stop_at_RTL {params.RTL} -r {params.r} {input}
		"""

rule extract_sequences_step5:
	input: treemmer="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.trim." + conserved_residues + ".fasttree.tre" + "_trimmed_list_RTL_" + str(RTL),
		fasta="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.faa"
	output: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.faa"
	conda: "envs/Bio.yaml"
	shell:
		"""
		python bin/fastaGrep.py {input.treemmer} {input.fasta} > {output}
		"""

rule reverse_sequences_step5:
	input: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.faa"
	output: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned_rev.faa"
	conda: "envs/Bio.yaml"
	shell:
		"""
		seqmagick convert --reverse --input-format fasta --output-format fasta {input} {output}
		"""

rule Mcoffee_fwd_step5:
	input:
		fwd="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.faa"
	output:
		fwd="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.aln"
	conda: "envs/tcoffee.yaml"
	shell:
		"""
		t_coffee -in {input} Mmafftlinsi_msa Mmafftginsi_msa Mclustalo_msa Mmuscle_msa Mt_coffee_msa -outfile {output}
		"""
rule Mcoffee_rev_step5:
	input:
		"results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned_rev.faa"
	output:
		"results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned_rev.aln"
	conda: "envs/tcoffee.yaml"
	shell:
		"""
		t_coffee -in {input} Mmafftlinsi_msa Mmafftginsi_msa Mclustalo_msa Mmuscle_msa -outfile {output}
		"""

rule reverse_alignment_step5:
	input: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned_rev.aln"
	output: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned_rev_rev.aln"
	conda: "envs/Bio.yaml"
	shell:
		"""
		seqmagick convert --reverse --input-format phylip --output-format phylip {input} {output}
		"""

rule tcoffee_combine_step5:
	input:
		fwd="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.aln",
		rev="results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned_rev_rev.aln"
	output: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.combined.aln"
	threads: ncpu
	conda: "envs/tcoffee.yaml"
	shell:
		"""
		t_coffee -in={input.fwd} -in={input.rev} -evaluate_mode=t_coffee_slow -thread={threads}
		"""

rule trimal_step5:
	input: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.combined.aln"
	output: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.combined.trim.aln"
	shell:
		"trimal -in {input} -out {output} -gappyout"

rule conserved_trim_step5:
	input: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.combined.trim.aln"
	output: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.combined.trim." + final_residues + ".aln"
	params: config["final_residues"]
	conda: "envs/Bio.yaml"
	shell:
		"python bin/filter_shortSeqs_MSA.py {input} {params} > {output}"

rule iqtree_step5:
	input: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.combined.trim.aln"
	output: "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.combined.trim." + final_residues + ".treefile"
	params: prefix= "results/{sample}." + cd_hit_identity + ".trim." + conserved_residues + ".noLong.focalclade.homologs.selected.pruned.combined.trim." + final_residues
	threads: ncpu
	shell:
		"""
		iqtree -s {input} -m MFP -mset LG,LG+10,LG+20,LG+30,LG+40,LG+50,LG+60,LG4M,LG4X -mrate ,R4,R5,R6,R7,R8,R9,R10,G4 \
			-mfreq ,F -T {threads} -wsl -wbt -alrt 1000 -bb 1000 -seed 12345 -pre {params.prefix}
		"""

